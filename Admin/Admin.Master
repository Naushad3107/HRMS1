<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="HRMS.Admin.Admin" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>

            <h1 style="text-align: center;">Admin Portal</h1>


            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container-fluid">
                    <a class="navbar-brand">HRMS</a>


                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="../AdminPage.aspx">Home</a>
                            </li>




                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-Employee" role="button" data-bs-toggle="dropdown" aria-expanded="false">Employee
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="../AllEmpData.aspx">All Employees</a></li>
                                    <li><a class="dropdown-item" href="../AddEmp.aspx">Add Employee</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                </ul>
                            </li>


                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-Department" role="button" data-bs-toggle="dropdown" aria-expanded="false">Department
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="../AddDeptForm.aspx">Add Department</a></li>
                                    <li><a class="dropdown-item" href="../ViewActiveDept.aspx">View All Departments</a></li>

                                    <li><a class="dropdown-item" href="../Admin/Add Designation.aspx">Add Designation</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                </ul>
                            </li>



                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-Employee" role="button" data-bs-toggle="dropdown" aria-expanded="false">Training
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="../TrainingModule/AddTrainer.aspx">Add New Trainer</a></li>
                                    <li><a class="dropdown-item" href="../TrainingModule/AddTrainingType.aspx">Training Type</a></li>
                                    <li><a class="dropdown-item" href="../TrainingModule/AddTrainingList.aspx">Training List</a></li>
                                    <li><a class="dropdown-item" href="../TrainingModule/TrainingPage.aspx">Training Page</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>

                                </ul>
                            </li>




                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-EmployeeHoliday" role="button" data-bs-toggle="dropdown" aria-expanded="false">Events
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="../LeaveModule/AddEvent.aspx">Add Event</a></li>
                                    <li><a class="dropdown-item" href="../LeaveModule/AddEventType.aspx">Add Event Type</a></li>
                                    <li><a class="dropdown-item" href="../LeaveModule/EventList.aspx">Event List</a></li>

                                </ul>
                            </li>



                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownPayslips" role="button" data-bs-toggle="dropdown" aria-expanded="false">Master Documents</a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownPayslips">

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown">Add Master document</a>
                                        <ul class="dropdown-submenu">
                                            <li><a class="dropdown-item" href="../Documents/AddAdminDocument.aspx">Add Admin Document</a></li>
                                            <li><a class="dropdown-item" href="../Documents/AddEmployeeDocument.aspx">Add Employee Document</a></li>
                                        </ul>
                                    </li>

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown">Master document List</a>
                                        <ul class="dropdown-submenu">
                                            <li><a class="dropdown-item" href="../Documents/AdminDocumentList.aspx">Admin Document List</a></li>
                                            <li><a class="dropdown-item" href="../Documents/EmployeeDocumentList.aspx">Employee Document List</a></li>
                                        </ul>
                                    </li>

                                </ul>
                            </li>


                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownPayslips" role="button" data-bs-toggle="dropdown" aria-expanded="false">Documents</a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownPayslips">

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown">document</a>
                                        <ul class="dropdown-submenu">
                                            <li><a class="dropdown-item" href="../Documents/AdminFileUpload.aspx">Admin File Upload</a></li>
                                            <li><a class="dropdown-item" href="../Documents/AdminUploadedDocumentList.aspx">Admin File Upload List</a></li>
                                        </ul>
                                    </li>

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown">Generate Leter</a>
                                        <ul class="dropdown-submenu">
                                            <li><a class="dropdown-item" href="../Offer_Relieving_code/GenerateOfferLetter.aspx">Offer Letter</a></li>
                                            <li><a class="dropdown-item" href="../Offer_Relieving_code/Relieving.aspx">Relieving Leter</a></li>
                                        </ul>
                                    </li>

                                </ul>
                            </li>





                        </ul>

                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdownUser"
                                    role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span><%= Session["User"] %></span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownUser">
                                    <li><a class="dropdown-item" href="../Admin/ViewEmpDetailsAdmin.aspx">My Profile</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a class="dropdown-item" style="color: red" href="../LoginPage.aspx">Logout</a></li>
                                </ul>
                            </li>
                        </ul>



                    </div>
                </div>
            </nav>





            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
